# Host ports
# -----------------------------------------------------------------------------
MOSS_FRONTEND_PORT=3000
MOSS_SERVER_PORT=8080
GSTORE_PORT=5003
VIRTUOSO_PORT=5004

# -----------------------------------------------------------------------------
# Virtuoso (SPARQL store behind gstore)
# -----------------------------------------------------------------------------
VIRTUOSO_DBA_PASSWORD=everyoneknows
VIRTUOSO_DEFAULT_GRAPH=http://localhost:2000

# -----------------------------------------------------------------------------
# GStore (graph / file storage)
# -----------------------------------------------------------------------------
GSTORE_STORAGE_USER=dba
GSTORE_STORAGE_PASS=everyoneknows
GSTORE_JSONLD_CONTEXT_URL=http://localhost:3000/res/context.jsonld
GSTORE_JSONLD_CONTEXT_LOCATION=https://databus.dbpedia.org/res/context.jsonld

# -----------------------------------------------------------------------------
# OpenID Connect (shared by MOSS server and frontend)
# Register redirect URL for the frontend origin, e.g.:
#   http://localhost:3000/auth/callback/keycloak
# -----------------------------------------------------------------------------
AUTH_OIDC_ISSUER=https://auth.dbpedia.org/realms/dbpedia
AUTH_OIDC_CLIENT_ID=moss-dev
AUTH_OIDC_CLIENT_SECRET=change-me
AUTH_OIDC_CLIENT_SCOPE=openid profile email
AUTH_OIDC_DISCOVERY_URL=

# Auth.js session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-random-secret
AUTH_TRUST_HOST=true
AUTH_DEBUG=false

# MOSS server admin access (comma-separated usernames)
AUTH_ADMIN_USERS=
AUTH_ADMIN_ROLE=

# -----------------------------------------------------------------------------
# MOSS server
# -----------------------------------------------------------------------------
MOSS_BASE_URL=http://localhost:8080
MOSS_LOG_LEVEL=INFO

# Optional: import an extra CA into the JVM truststore inside the container
EXTRA_ROOT_CERT_PATH=

# -----------------------------------------------------------------------------
# MOSS frontend
# -----------------------------------------------------------------------------
PUBLIC_MOSS_BASE_URL=http://localhost:8080
MOSS_API_SERVER_URL=http://moss-server:8080
ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Outbound HTTP proxy (optional — JVM and Node)
# -----------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,moss-server,moss-frontend,gstore,virtuoso
